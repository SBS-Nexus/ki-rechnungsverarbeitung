# SBS KI-Rechnungsverarbeitung – Beispiel-Umgebungsvariablen
# Kopieren nach .env (lokal) bzw. in /etc/default/invoice-app (Produktion).
# NIEMALS echte Secrets committen.

# --- Datenbank (PostgreSQL / Neon) ---------------------------------------
# Neon-Connection-String (psycopg3-Treiber, SSL erforderlich):
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/ki_rechnungsverarbeitung?sslmode=require

# --- Web/Session-Security ------------------------------------------------
# Zufälliger, langer Wert. Erzeugen z. B. mit:  openssl rand -hex 32
SESSION_SECRET_KEY=
# Shared-SSO-Secret (gleich auf allen SBS-Apps)
JWT_SECRET=

# --- LLM / KI ------------------------------------------------------------
OPENAI_API_KEY=
MBR_LLM_API_KEY=
ANTHROPIC_API_KEY=

# --- OAuth / SSO ---------------------------------------------------------
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_SECRET=

# --- E-Mail / Sonstiges --------------------------------------------------
SENDGRID_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
